# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.local

# Environment files — NEVER commit real credentials or endpoints.
# .env.example is the tracked template; everything else stays local.
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.suo
*.ntvs*
*.njsproj
*.sln

# OS
.DS_Store
Thumbs.db

# Tooling caches
.eslintcache
*.tsbuildinfo
.cache/

# Measurement output. The JSON report is committed as evidence; the screenshots
# are large, regenerate from `npm run measure:avatar`, and are not reviewable in
# a diff.
web/measurements/*.png
