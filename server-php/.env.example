# ---------------------------------------------------------------------------
# Lobby API — server environment template
#
# Unlike the React build, this file is read at RUNTIME on every request. It
# belongs on the server and only on the server:
#
#   1. Copy this file to <document root>/api/.env by hand, once (cPanel File
#      Manager or SSH).
#   2. It is git-ignored, and every rsync step passes --exclude='.env', so a
#      --delete deploy leaves it untouched.
#
# See docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# Which deployment this is: production | sandbox | local
# Reported by GET /api/health, so you can tell the two environments apart.
APP_ENV=production

# AICOUNTLY portal auth API. Leave unset unless you are pointing at a
# non-standard portal — my.aicountly.com serves BOTH production and sandbox.
# (sandbox.aicountly.com is a login redirect only; it does not serve seskey or
# validatesession.)
# PORTAL_AUTH_BASE=https://my.aicountly.com

# Comma-separated origins allowed to call this API cross-origin.
# Both deployed environments are same-origin with their app, so leave this
# empty in production. It exists for `npm run dev` against a deployed API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Reception AI (Phase 2C)
#
# Everything below is server-side only. None of it may ever appear as a VITE_*
# value: those are inlined into the browser bundle at build time and are public.
# The browser is given an API path, never a provider credential.
# ---------------------------------------------------------------------------

# --- Visitor sessions ------------------------------------------------------
# REQUIRED before reception can answer. Signs the short-lived token issued to a
# public visitor; the token carries the conversation id and the tenant so the
# browser can never name either. Must be at least 32 characters.
#   php -r 'echo bin2hex(random_bytes(32)), "\n";'
# LOBBY_SESSION_SECRET=

# How long one reception session lasts. Default 3600, capped at 86400.
# LOBBY_SESSION_TTL_SECONDS=3600

# Which tenant this deployment serves. Derived server-side and never read from
# a request body. Use the host map when one server answers for several tenants.
# LOBBY_TENANT_ID=default
# LOBBY_TENANT_BY_HOST=lobby.aicountly.com=acme,lobby.gh.aicountly.com=acme-sandbox

# Where the rate limiter keeps its counters. Must be writable by PHP.
# Defaults to the system temp directory.
# LOBBY_STATE_DIR=/home/USER/lobby-state

# ---------------------------------------------------------------------------
# Where this product keeps the little it owns (Phase 3)
#
# REQUIRED before anything can be configured from the setup screens.
#
# Lobby owns three things and must never acquire a fourth: the tenant's
# approved reception configuration, the live reception queue, and who has
# access. Appointments, Calendar, Contacts, Manage and Billing own everything
# else and are read over their APIs.
#
# It MUST be an absolute path OUTSIDE the document root. Both deploys rsync
# server-php/ into <docroot>/api with --delete, so anything underneath that
# path which is not in the repository is removed on the next deploy — that is
# exactly how knowledge.json came to need an explicit exclusion.
#
# Unset, the setup screens report that there is nowhere to save and reception
# keeps reading knowledge.json exactly as it did before. An EMPTY value counts
# as unset: it is refused rather than resolved, because an empty path would
# make every write absolute from the filesystem root.
#
# If LOBBY_STATE_DIR is set and this is not, a `data` directory beneath it is
# used.
# LOBBY_DATA_DIR=/home/USER/lobby-state/data

# --- Who may administer this deployment -------------------------------------
# REQUIRED before anybody can open the setup screens.
#
# A comma-separated list of AICOUNTLY portal uuids that are owners here. This
# is the bootstrap and it has to exist: without it nobody can grant anybody the
# first role, and the alternative — whoever signs in first becomes the owner —
# is a land grab on a public product.
#
# Everyone else is added from the interface under "Who has access". A person
# signing in without a role is shown their own uuid, which is what you paste
# here or into that screen.
# LOBBY_OWNER_UUIDS=

# --- The reception desk -----------------------------------------------------
# How many people may be waiting before the desk stops admitting more.
# LOBBY_QUEUE_CAPACITY=25

# Whether a visitor may be queued when this server has not seen anybody at the
# desk. Staff availability is normally OBSERVED — loading the desk screen is
# the heartbeat — because "somebody is available" with nobody logged in is the
# most damaging thing a reception product can display: the visitor waits on the
# strength of it.
#
# Set this only where staff work from a screen this product does not serve, so
# the heartbeat can never fire. The operator diagnostic reports it when it is
# on, because it is the one switch that makes this product claim availability
# it has not observed.
# LOBBY_DESK_ALWAYS_OPEN=false

# Only set if this server sits behind a proxy you control. Without it the
# limiter counts the proxy's address, and with it set wrongly a caller can
# spoof X-Forwarded-For and bypass every per-address limit.
# TRUSTED_PROXY_IPS=

# --- AI provider credentials, from Console ----------------------------------
# REQUIRED before reception can answer.
#
# console.aicountly.org is the fleet's system of record for AI provider keys.
# The provider key is NOT set here: Console holds it encrypted and hands it over
# on GET /ai/credentials/resolve, authenticated by the service key below. Only
# these three lines live on this host, and none of them is a provider key.
#
# Nothing is written to disk. The answer is held in process memory and, where
# APCu is available, in shared memory, for a few minutes.
#
#   1. In Console, under the domain named by CONSOLE_AI_DOMAIN, bind an active
#      credential to the "reception" module.
#   2. Set the two values below to the same Console API base and service key
#      every other product on this fleet uses.
#
# CONSOLE_API_URL=https://console.aicountly.org/api
# CONSOLE_SERVICE_KEY=

# Which source may answer, using the fleet's switch:
#   console (default here) — Console only; fail closed when it cannot answer
#   auto                   — fall back to LOBBY_AI_API_KEY below and log that it did
#
# The rest of the fleet defaults to `auto` so a product that already shipped a
# key in .env can migrate one host at a time. Reception never had one, so there
# is nothing here for `auto` to protect.
# AI_CREDENTIALS_SOURCE=console

# Which domain row in Console this deployment resolves under. Console matches
# ai_domains.domain exactly, so this is a hostname, not a slug. Set it on a
# sandbox deployment so it cannot resolve production's binding.
# CONSOLE_AI_DOMAIN=lobby.aicountly.com

# --- Conversation ----------------------------------------------------------
# The model and the key both come from the Console binding above. These two are
# only what to do when Console named no model, and how long to wait.
# LOBBY_AI_MODEL=claude-opus-5
# LOBBY_AI_TIMEOUT_SECONDS=25

# LOCAL DEVELOPMENT ONLY. Read solely when CONSOLE_API_URL/CONSOLE_SERVICE_KEY
# are both unset, so a developer without Console can still run reception. It is
# deliberately NOT a failover for a Console that is configured but unreachable:
# a quiet second copy of the key is how a revoked key keeps working for months.
# On this server, leave it unset.
# LOBBY_AI_API_KEY=

# --- Approved business knowledge -------------------------------------------
# SUPERSEDED by the setup screens in Phase 3, and still read.
#
# This file was the Phase 2C way to brief the receptionist: hand-edited on the
# server, one tenant per host. It is now imported ONCE into the tenant's
# published configuration on first read, and then left exactly where it is —
# nothing deletes it, it is yours, and it is the rollback.
#
# The import is skipped as soon as anything is published, including an empty
# document, so clearing everything deliberately stays cleared.
#
# With no LOBBY_DATA_DIR set, this file is still read directly and reception
# answers exactly as it did before; only the setup screens are unavailable.
# LOBBY_KNOWLEDGE_FILE=/home/USER/public_html/api/knowledge.json

# --- Booking, through Aicountly Appointments --------------------------------
# Optional. Unset means the booking journey reports itself unavailable.
#
# Appointments owns appointment types, availability, holds and bookings, and
# reaches Aicountly Calendar itself. Lobby asks over HTTP at the moment it
# needs an answer and keeps nothing — no mirrored appointment table, no cached
# slot list, no calendar credential.
#
# The call is made by THIS server, never the browser: it carries the service
# key below, and every VITE_* value is inlined into the bundle and is public.
#
# Which company to book against is per tenant and is set in the setup screens
# under Visitor services, not here.
# LOBBY_APPOINTMENTS_API_BASE=https://appointments.aicountly.com
#
# Issued by Appointments for this product. NOT a Console credential — Console
# governs AI provider keys; this is a fleet service key.
# LOBBY_APPOINTMENTS_SERVICE_KEY=

# --- Speech (text to speech) ------------------------------------------------
# Optional. Unset means replies are not spoken by the server; the browser's own
# voice is used where the browser has one, and the interface says which it is.
# Vendor-neutral: point these at whichever speech service is approved.
# {{text}} and {{voice}} are substituted, JSON-escaped, into the template.
# LOBBY_TTS_PROVIDER_NAME=
# LOBBY_TTS_URL=
# LOBBY_TTS_AUTH_HEADER=Authorization
# LOBBY_TTS_AUTH_VALUE=Bearer REPLACE
# Set this instead of LOBBY_TTS_AUTH_VALUE to take the key from the Console
# binding for the "text_to_speech" module, so it rotates in one place. Opt-in,
# because nothing here can check that a Console-held key belongs to the vendor
# LOBBY_TTS_URL points at, and a key sent to the wrong vendor is a disclosed key.
# LOBBY_TTS_AUTH_FROM_CONSOLE=false
# LOBBY_TTS_BODY_TEMPLATE={"text":"{{text}}","voice":"{{voice}}","format":"mp3"}
# LOBBY_TTS_VOICE=
# LOBBY_TTS_ACCEPT=audio/mpeg
# LOBBY_TTS_MAX_BYTES=4194304
# LOBBY_TTS_TIMEOUT_SECONDS=20

# --- Transcription (speech to text) ----------------------------------------
# Optional. Unset means voice input uses the browser's own recogniser where it
# has one. Audio is posted as multipart/form-data and never stored.
# LOBBY_STT_PROVIDER_NAME=
# LOBBY_STT_URL=
# LOBBY_STT_AUTH_HEADER=Authorization
# LOBBY_STT_AUTH_VALUE=Bearer REPLACE
# As above, but for the Console "speech_to_text" module.
# LOBBY_STT_AUTH_FROM_CONSOLE=false
# LOBBY_STT_FILE_FIELD=file
# LOBBY_STT_MODEL=
# LOBBY_STT_LANGUAGE=
# LOBBY_STT_TEXT_PATH=text
# LOBBY_STT_TIMEOUT_SECONDS=30

# --- Limits -----------------------------------------------------------------
# Sized to stop runaway cost and abuse on a public page, not to meter billing.
# LOBBY_SESSION_LIMIT_PER_HOUR=60
# LOBBY_RECEPTION_LIMIT_PER_MINUTE=12
# LOBBY_RECEPTION_LIMIT_PER_HOUR=120
# LOBBY_RECEPTION_LIMIT_PER_DAY=2000
# LOBBY_SPEECH_LIMIT_PER_MINUTE=20
# LOBBY_TRANSCRIBE_LIMIT_PER_MINUTE=12
# LOBBY_HANDOVER_LIMIT_PER_MINUTE=6
# LOBBY_HANDOVER_LIMIT_PER_HOUR=60
# Tighter than the rest: a booking reaches another product and can create a
# record there.
# LOBBY_BOOKING_LIMIT_PER_HOUR=10
# LOBBY_BOOKING_LIMIT_PER_DAY=40
